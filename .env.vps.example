# Apenas API e PostgreSQL. O frontend continua no Netlify.
# Gere cada segredo com: openssl rand -hex 32
# Use caracteres hexadecimais na senha para compor a DATABASE_URL.
POSTGRES_PASSWORD=
SECRET_KEY=
FRONTEND_PUBLIC_URL=https://acacademia.netlify.app
BACKEND_CORS_ORIGINS=https://acacademia.netlify.app
API_ROOT_PATH=/academia-api
API_BIND_PORT=8020

# Limites iniciais para um ensaio, ainda nao validados sob carga de producao.
API_MEMORY_LIMIT=192m
DB_MEMORY_LIMIT=128m
