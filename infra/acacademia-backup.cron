# Backup diario do banco AC Academia na VPS.
15 3 * * * root cd /home/ubuntu/ac-academia && /usr/bin/docker compose -p ac-academia --env-file .env.vps -f docker-compose.vps.yml run --rm backup >> /var/log/acacademia-backup.log 2>&1
20 3 * * * root cd /home/ubuntu/ac-academia && /usr/bin/docker compose -p ac-academia --env-file .env.vps -f docker-compose.vps.yml exec -T backend python -m app.jobs.generate_monthly >> /var/log/acacademia-monthly.log 2>&1
